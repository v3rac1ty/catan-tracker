# Copy to .env and fill in real values. Never commit .env.
#
# Generate URL-safe passwords with:
#   openssl rand -hex 24

# --- Postgres superuser bootstrap (docker compose `db` service) ---
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=

# Host port the `db` service is published on (localhost-only). Change if
# 5432 is already taken on your machine.
DB_HOST_PORT=5432

# --- Discord bot ---
DISCORD_TOKEN=
# Optional: guild ID to sync slash commands to instantly during development.
# Leave unset to sync commands globally (can take up to an hour to propagate).
DEV_GUILD_ID=

# --- Connection strings used when running outside docker compose, e.g. via
#     .venv for local dev, migrations, or tests. Inside docker compose, the
#     `migrate` and `bot` services build their own DSNs from the passwords
#     above and the `db` service hostname. ---
DATABASE_URL=postgresql://catan_app:<APP_PASSWORD>@localhost:5432/catan
MIGRATOR_DATABASE_URL=postgresql://catan_migrator:<MIGRATOR_PASSWORD>@localhost:5432/catan

# --- Integration tests (catan_test database) ---
TEST_DATABASE_URL=postgresql://catan_app:<APP_PASSWORD>@localhost:5432/catan_test
TEST_MIGRATOR_DATABASE_URL=postgresql://catan_migrator:<MIGRATOR_PASSWORD>@localhost:5432/catan_test
